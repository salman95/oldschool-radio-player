# RadioApp Docker Configuration
# Copy to .env and modify as needed

# Host port to publish the app on
PORT=6767
TZ=UTC

# Run the container as this user/group. Must own ./data — check with `id -u` and `id -g`.
PUID=1000
PGID=1000

# Password for the initial "admin" account (used on first start only).
# If unset, a random password is generated and printed once in the container logs.
#ADMIN_PASSWORD=

# Optional: DeepSeek API key. Takes precedence over a key saved in the AI News screen.
#DEEPSEEK_API_KEY=

# Optional: secret used to encrypt the saved API key in the database.
# If unset, a random key is generated and stored in data/secret.key.
#APP_SECRET=

# Set to 1 when the app is served over HTTPS so the session cookie is marked Secure.
# (Requests with "X-Forwarded-Proto: https" from a reverse proxy get it automatically.)
#COOKIE_SECURE=1
